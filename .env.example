# Copy to .env.local and fill in. Never commit real values — .env*.local is gitignored.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://localhost:3000   # Public base URL, used to build OAuth redirect URIs

# --- Firebase (client) -------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=                # Firebase web API key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=            # <project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=             # Firebase project id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=         # <project>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=    # Firebase Cloud Messaging sender id
NEXT_PUBLIC_FIREBASE_APP_ID=                 # Firebase web app id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=         # Optional Google Analytics measurement id

# --- Firebase (server / admin SDK) -------------------------------------------
FIREBASE_PROJECT_ID=                         # Project id for firebase-admin
FIREBASE_SERVICE_ACCOUNT_KEY=                # Full service account JSON, as a single line (alternative to the pair below)
FIREBASE_CLIENT_EMAIL=                       # Service account client email
FIREBASE_PRIVATE_KEY=                        # Service account private key, newlines escaped as \n

# --- Maps and routing --------------------------------------------------------
NEXT_PUBLIC_BASEMAP_PROVIDER=                # Basemap style to use (see src/lib/basemap.ts)
NEXT_PUBLIC_MAPTILER_API_KEY=                # MapTiler key, if that basemap is selected
NEXT_PUBLIC_STADIA_API_KEY=                  # Stadia Maps key, if that basemap is selected
NEXT_PUBLIC_CARTO_API_KEY=                   # CARTO key, if that basemap is selected
OPENROUTESERVICE_API_KEY=                    # openrouteservice key for route generation

# --- Strava (existing personal-use adapter) ----------------------------------
STRAVA_CLIENT_ID=                            # Strava API application client id
STRAVA_CLIENT_SECRET=                        # Strava API application secret; also signs the Strava OAuth state

# --- Ingestion spine: encryption ---------------------------------------------
# 32 bytes, as 64 hex characters or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=                        # AES-256-GCM key encrypting every provider token at rest — required before any provider can be connected
ERASURE_RECEIPT_SALT=                        # Salt making erasure receipts unlinkable to a user id; falls back to TOKEN_ENCRYPTION_KEY

# --- intervals.icu adapter ---------------------------------------------------
INTERVALS_CLIENT_ID=                         # OAuth client id from https://intervals.icu/oauth/apply
INTERVALS_CLIENT_SECRET=                     # OAuth client secret; also signs the intervals.icu OAuth state
INTERVALS_WEBHOOK_SECRET=                    # Shared secret set on the "Manage App" page; without it the webhook rejects every delivery
INTERVALS_WEBHOOK_SIGNATURE_HEADER=          # Optional override for the HMAC signature header name (default x-intervals-signature)
INTERVALS_WEBHOOK_SECRET_HEADER=             # Optional override for the shared-secret header name (default x-webhook-secret)
INTERVALS_USER_AGENT=                        # Optional User-Agent; intervals.icu sits behind Cloudflare and dislikes anonymous clients

# --- GDPR: retention and disclosure ------------------------------------------
STORE_RAW_PAYLOADS=true                      # Set to false to never retain original provider files at all
RAW_PAYLOAD_RETENTION_DAYS=30                # TTL for original provider files
CONSENT_RETENTION_DAYS=1095                  # How long consent evidence is kept to demonstrate Art. 7(1) compliance
SYNC_AUDIT_RETENTION_DAYS=90                 # TTL for sync and webhook delivery audit records
DEFAULT_RETENTION_DAYS=90                    # Fallback TTL for any future retention policy
GDPR_CONTROLLER_NAME=                        # Data controller name shown in the data export
GDPR_CONTACT_EMAIL=                          # Contact address for data subject requests
